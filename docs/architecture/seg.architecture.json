  "cards": [
    {
      "dot": "cyan",
      "title": "Evaluator graph",
      "items": [
        "The DAG is executable, dependency-aware and parallel by wave \u2014 not a decorative flowchart.",
        "Wave 1: schema, links/syntax, safety/privacy and portability. Wave 2: trigger routing, token economics and behavioural policy coverage.",
        "Each node records status, duration, findings, metrics, evidence, input digest and output digest."
      ]
    },
    {
      "dot": "violet",
      "title": "Decision and repair",
      "items": [
        "Evidence Join fails closed on evaluator failure before the Oracle evaluates integrity, specification, safety/privacy, links and quality policy.",
        "REVISE stages deterministic repairs in an isolated sandbox, re-evaluates the candidate and previews a verified diff.",
        "Mutation is explicit opt-in and protected by a backup/rollback path."
      ]
    },
    {
      "dot": "emerald",
      "title": "Behaviour and provenance",
      "items": [
        "Live behaviour is a separate control-vs-treatment benchmark path with repeated trials.",
        "Trials measure compliance, uplift, rationalisations, latency variance and infrastructure failures.",
        "Canonical SHA-256 receipts preserve target, configuration, node, Oracle and repair evidence as tamper-evident artifacts."
      ]
    }
  ]
